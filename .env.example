# Book Organiser — container configuration.
# Copy this file to `.env` and edit the values, then run `docker compose up -d --build`.
# The host-mount paths below assume a Raspberry Pi with an SSD (data) + SD (config)
# and a media/NAS share holding the source books. Change them for your setup.

# ── Calibre ────────────────────────────────────────────
# 1 = install calibre inside the image (high-fidelity AZW3/MOBI/FB2 conversion)
# 0 = slim image (default); rendering falls back to the built-in pure-Python reader
WITH_CALIBRE=0

# ── Host mount points (edit to match your Pi/NAS) ─────
# SQLite DB, covers, enrich cache (keep on SSD for speed)
DATA_HOST_PATH=/mnt/ssd/book-organiser/data
# Logs + config overrides (tiny writes)
CONFIG_HOST_PATH=/mnt/sd/book-organiser/config
# Source books (must contain your ebooks; mounted read-only)
BOOKS_HOST_PATH=/mnt/media_ssd/books

# ── Application ──────────────────────────────────────────
# Container image name (main docker-compose relies on it); leave as-is for local build
# BOOK_ORGANISER_IMAGE=book-organiser:latest
# Host port to publish the web UI on
BOOK_PORT=5000
# Timezone
TZ=Europe/London

# ── Auth (optional) ────────────────────────────────────
BOOK_AUTH_PASSWORD=
BOOK_SECRET_KEY=change-me-in-production

# ── Enrichment (optional) ──────────────────────────────
GOOGLE_BOOKS_API_KEY=
ZLIB_BASE_URL=https://zlib.li
